# Dev environment — copy to .env
# docker compose up

# Django
SECRET_KEY=dev-insecure-key-change-this-locally
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (matches docker-compose.yml db service)
DB_PASSWORD=devpass
DATABASE_URL=postgres://football_user:devpass@db:5432/football_intel

# Redis (matches docker-compose.yml redis service)
REDIS_PASSWORD=devredis
REDIS_URL=redis://:devredis@redis:6379/0
CELERY_BROKER_URL=redis://:devredis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:devredis@redis:6379/2

# AI — use real key or leave blank to skip AI features locally
ANTHROPIC_API_KEY=sk-ant-replace-me


# Telegram — use test bot token for dev, never prod token
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret-32chars-minimum

# Football APIs — free tier keys OK for dev
FOOTBALL_DATA_API_KEY=replace-me
NEWSAPI_KEY=replace-me
GNEWS_API_KEY=replace-me

# Sentry — leave blank in dev
SENTRY_DSN=
