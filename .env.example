# Copy this to .env (local) or .env.prod (VPS)
# Never commit the actual .env files to Git

# Django
SECRET_KEY=replace-with-python-secrets-token-hex-50
DEBUG=True                        # False in production
ALLOWED_HOSTS=localhost,127.0.0.1 # Add your VPS IP or domain in prod

# Database
DB_PASSWORD=choose_strong_password
DATABASE_URL=postgres://football_user:choose_strong_password@db:5432/football_intel

# Redis
REDIS_PASSWORD=choose_strong_redis_password
REDIS_URL=redis://:choose_strong_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:choose_strong_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:choose_strong_redis_password@redis:6379/2

# AI
ANTHROPIC_API_KEY=sk-ant-replace-me

# Telegram
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-32-char-string

# Football APIs
FOOTBALL_DATA_API_KEY=replace-me
NEWSAPI_KEY=replace-me
GNEWS_API_KEY=replace-me

# Monitoring (optional)
SENTRY_DSN=
