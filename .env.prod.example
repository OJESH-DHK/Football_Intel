# Production environment — copy to .env.prod on VPS
# NEVER commit .env.prod to Git
# docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# Django
SECRET_KEY=replace-with-python-secrets.token_hex(50)-output
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database
DB_PASSWORD=use-a-strong-random-password-min-32-chars
DATABASE_URL=postgres://football_user:use-a-strong-random-password-min-32-chars@db:5432/football_intel

# Redis
REDIS_PASSWORD=use-a-strong-random-redis-password-min-32-chars
REDIS_URL=redis://:use-a-strong-random-redis-password-min-32-chars@redis:6379/0
CELERY_BROKER_URL=redis://:use-a-strong-random-redis-password-min-32-chars@redis:6379/1
CELERY_RESULT_BACKEND=redis://:use-a-strong-random-redis-password-min-32-chars@redis:6379/2

# AI
ANTHROPIC_API_KEY=sk-ant-your-production-key

# Telegram — prod bot token (different from dev bot)
TELEGRAM_BOT_TOKEN=your-prod-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-32-char-string

# Football APIs
FOOTBALL_DATA_API_KEY=your-prod-key
NEWSAPI_KEY=your-prod-key
GNEWS_API_KEY=your-prod-key

# Monitoring — required in prod
SENTRY_DSN=https://your-key@sentry.io/your-project-id
